{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "WellPassport",
  "type": "object",
  "required": ["well_id", "depth_m", "q_liq", "w_pct", "is_active", "field_name", "pump"],
  "additionalProperties": false,
  "properties": {
    "well_id": {
      "type": "string",
      "pattern": "^W-\\d{3}$"
    },
    "depth_m": {
      "type": "number",
      "minimum": 0,
      "maximum": 5000
    },
    "q_liq": {
      "type": "number",
      "minimum": 0
    },
    "w_pct": {
      "type": "number",
      "minimum": 0,
      "maximum": 100
    },
    "is_active": {
      "type": "boolean"
    },
    "field_name": {
      "type": "string",
      "minLength": 3,
      "maxLength": 100
    },
    "pump": {
      "type": "object",
      "required": ["model", "power_kw"],
      "additionalProperties": false,
      "properties": {
        "model": {
          "type": "string"
        },
        "power_kw": {
          "type": "number",
          "minimum": 0
        }
      }
    }
  }
}
